Algoritmo NumeroMayor
	Definir number1, number2 Como Real
	Imprimir "Ingrese el número 1: "
	leer number1
	Imprimir "Ingrese el número 2: "
	leer number2
	Si number1 == number2 Entonces
		Imprimir "Son iguales"
	SiNo
		si number1 > number2 Entonces
		Imprimir "El primer número es mayor"
		SiNO
			Imprimir "El segundo es mayor"
		FinSi
	Fin Si
FinAlgoritmo
